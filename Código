<script>
  const currentNeedle = document.getElementById("currentNeedle");
  const targetNeedle = document.getElementById("targetNeedle");
  const statusPill = document.getElementById("statusPill");
  const message = document.getElementById("message");
  const stopMessage = document.getElementById("stopMessage");
  const stopButton = document.getElementById("stopButton");
  const continueButton = document.getElementById("continueButton");
  const testBannerCard = document.getElementById("testBannerCard");
  const testBannerText = document.getElementById("testBannerText");

  function stateClass(stateCode) {
    if (stateCode === "MOVING") return "moving";
    if (stateCode === "RESTING") return "resting";
    if (stateCode === "SAFETY_LOCK") return "error";
    return "waiting";
  }

  function physicalToCssAngle(physicalAngle) {
    return -Number(physicalAngle);
  }

  async function refreshStatus() {
    try {
      const response = await fetch("/status", { cache: "no-store" });
      const data = await response.json();

      document.getElementById("state").textContent = data.stateText;
      statusPill.className = "status " + stateClass(data.stateCode);

      const rtcStat = document.getElementById("rtcStatus");
      if (!data.rtcDetected) {
        rtcStat.textContent = "Desconectado / Error I2C";
        rtcStat.style.color = "#ef4444";
        document.getElementById("clock").textContent = "RTC no detectado";
      } else if (!data.timeValid) {
        rtcStat.textContent = "Conectado, hora no válida";
        rtcStat.style.color = "#f59e0b";
        document.getElementById("clock").textContent = "RTC detectado, pero requiere sincronización";
      } else {
        rtcStat.textContent = "Conectado y funcionando";
        rtcStat.style.color = "#22c55e";
        document.getElementById("clock").textContent = data.time;
      }

      const mpuStat = document.getElementById("mpuStatus");
      mpuStat.textContent = data.mpuDetected ? "Conectado y Leyendo" : "Desconectado / Error";
      mpuStat.style.color = data.mpuDetected ? "#22c55e" : "#ef4444";

      document.getElementById("motor1Turns").textContent = Number(data.motor1Turns).toFixed(2);
      document.getElementById("stepDegreeValue").textContent = Number(data.anglePerInterval).toFixed(3) + "° / " + data.intervalMinutes + " min";

      const m1StatusBadge = document.getElementById("motor1Status");
      if (data.safetyLock) {
        m1StatusBadge.textContent = "BLOQUEADO CON TORQUE";
        m1StatusBadge.className = "badge-active";
      } else {
        m1StatusBadge.textContent = data.motor1Active ? "Activado (Frenado/Torque)" : "Desactivado";
        m1StatusBadge.className = data.motor1Active ? "badge-active" : "badge-inactive";
      }

      const isMoving = data.stateCode === "MOVING";
      const dir = data.motorDirection; 
      const speedDeg = data.motorSpeedDeg; 

      const m1Icon = document.getElementById("motor1Icon");
      const m1Status = document.getElementById("m1DynStatus");
      const m1Speed = document.getElementById("m1DynSpeed");

      m1Icon.setAttribute("class", "motor-icon"); 
      m1Status.textContent = "Detenido"; m1Status.style.color = "#64748b"; 
      m1Speed.textContent = "0.00 °/s"; m1Speed.style.color = "#64748b";

      if (isMoving && dir > 0) {
        m1Icon.setAttribute("class", "motor-icon spin-cw");
        m1Icon.style.animationDuration = Math.max(0.15, 60 / (data.motorSpeedPPS + 1)) + "s";
        m1Status.textContent = "Avanzando \u2192";
        m1Status.style.color = "#22c55e";
        m1Speed.textContent = Number(speedDeg).toFixed(2) + " °/s";
        m1Speed.style.color = "#22c55e";
      } 
      else if (isMoving && dir < 0) {
        m1Icon.setAttribute("class", "motor-icon spin-ccw");
        m1Icon.style.animationDuration = Math.max(0.15, 60 / (data.motorSpeedPPS + 1)) + "s";
        m1Status.textContent = "\u2190 Retornando";
        m1Status.style.color = "#f59e0b";
        m1Speed.textContent = Number(speedDeg).toFixed(2) + " °/s";
        m1Speed.style.color = "#f59e0b";
      }

      if (data.isPost6pmTest) {
        testBannerCard.style.display = "block";
        testBannerText.textContent = data.testMessage;
      } else {
        testBannerCard.style.display = "none";
      }

      if (data.mpuDetected) {
        document.getElementById("currentAngle").textContent = Number(data.currentAngle).toFixed(2) + "°";
        currentNeedle.style.transform = "rotate(" + physicalToCssAngle(data.currentAngle) + "deg)";
        currentNeedle.style.opacity = "1";
      } else {
