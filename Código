// ============================================================
// 6. DIAGNOSTICO I2C Y FUNCIONES DEL MPU6050
// ============================================================

bool i2cAddressResponds(TwoWire& bus, uint8_t address) {
  bus.beginTransmission(address);
  return bus.endTransmission() == 0;
}

void scanI2CBus(TwoWire& bus, const char* busName) {
  Serial.print("\n--- ESCANEO ");
  Serial.print(busName);
  Serial.println(" ---");

  uint8_t found = 0;

  for (uint8_t address = 1; address < 127; ++address) {
    bus.beginTransmission(address);
    const uint8_t error = bus.endTransmission();

    if (error == 0) {
      Serial.print("Dispositivo encontrado en 0x");
      if (address < 16) Serial.print('0');
      Serial.println(address, HEX);
      ++found;
    }
  }

  if (found == 0) {
    Serial.println("NINGUN dispositivo I2C encontrado en este bus.");
  }

  Serial.println("-------------------\n");
}

float normalizeAngle180(float angle) {
  while (angle > 180.0f) angle -= 360.0f;
  while (angle <= -180.0f) angle += 360.0f;
  return angle;
}

float shortestAngularDifference(float target, float current) {
  return normalizeAngle180(target - current);
}

void initializeMPU() {
  // Primero comprobamos que realmente exista un dispositivo en 0x68.
  if (!i2cAddressResponds(mpuWire, MPU6050_ADDR)) {
    if (mpuDetected) {
      Serial.println("MPU6050 perdido: 0x68 dejo de responder. BLOQUEO DE SEGURIDAD.");
    }
    mpuDetected = false;
    mpuFilterInitialized = false;
    return;
  }

  // Despertar MPU6050 escribiendo 0 en PWR_MGMT_1.
  mpuWire.beginTransmission(MPU6050_ADDR);
  mpuWire.write(0x6B);
  mpuWire.write(0x00);
  const uint8_t result = mpuWire.endTransmission();

  const bool wasDetected = mpuDetected;
  mpuDetected = (result == 0);

  if (mpuDetected && !wasDetected) {
    mpuFilterInitialized = false;
    Serial.println("MPU6050 detectado y despertado correctamente en 0x68.");
  } else if (!mpuDetected) {
    mpuFilterInitialized = false;
    Serial.println("Error al inicializar MPU6050 en 0x68.");
  }
}

bool readMPUAngle() {
  if (!mpuDetected) return false;

  mpuWire.beginTransmission(MPU6050_ADDR);
  mpuWire.write(0x3B); // ACCEL_XOUT_H

  if (mpuWire.endTransmission(false) != 0) {
    Serial.println("Error de lectura MPU6050. BLOQUEO DE SEGURIDAD y reintento automatico.");
    mpuDetected = false;
    mpuFilterInitialized = false;
    return false;
  }

  const uint8_t received = mpuWire.requestFrom(MPU6050_ADDR, (uint8_t)6, (uint8_t)true);
  if (received != 6 || mpuWire.available() < 6) {
    Serial.println("MPU6050 devolvio menos de 6 bytes. BLOQUEO DE SEGURIDAD.");
    mpuDetected = false;
    mpuFilterInitialized = false;
    return false;
  }

  const int16_t ax = (mpuWire.read() << 8) | mpuWire.read();
  const int16_t ay = (mpuWire.read() << 8) | mpuWire.read();
  const int16_t az = (mpuWire.read() << 8) | mpuWire.read();
  (void)ax;

  /*
   * Angulo de rotacion sobre el eje X.
   * El signo de Z se invierte por la orientacion fisica del sensor.
   */
  const float rawAngle = normalizeAngle180(
      atan2f((float)ay, -(float)az) * 180.0f / PI);

  // Primera lectura: se toma directamente para evitar que el filtro arranque desde 0°.
  if (!mpuFilterInitialized) {
    currentPanelAngle = rawAngle;
    mpuFilterInitialized = true;
    return true;
  }

  // Diferencia angular corta: evita el salto visual/control de ~360° al cruzar +180/-180°.
  const float angularDifference = shortestAngularDifference(rawAngle, currentPanelAngle);

  // Rechazo de un pico aislado imposible para la velocidad mecánica de este seguidor.
  // No se declara el MPU desconectado por una sola muestra ruidosa; simplemente se ignora.
  if (fabsf(angularDifference) > MPU_MAX_SINGLE_SAMPLE_JUMP_DEG) {
    return true;
  }

  // Filtro pasa-bajos exponencial (EMA).
  currentPanelAngle = normalizeAngle180(
      currentPanelAngle + MPU_FILTER_ALPHA * angularDifference);

  return true;
}

float clampPanelAngle(float angle) {
  if (angle < PANEL_MIN_ANGLE) return PANEL_MIN_ANGLE;
  if (angle > PANEL_MAX_ANGLE) return PANEL_MAX_ANGLE;
  return angle;
}

// ============================================================
// 7. RTC Y CALCULO HORARIO DISCRETIZADO
// ============================================================

bool isDateTimePlausible(const DateTime& value) {
  return value.year() >= 2024 && value.year() <= 2099;
}

bool readRtcClock(DateTime& currentTime) {
  if (!rtcDetected) return false;

  // lostPower() indica que el RTC existe, pero su hora no es confiable.
  if (rtc.lostPower()) return false;

  currentTime = rtc.now();
  return isDateTimePlausible(currentTime);
}

void checkAndResetDailyPulses(const DateTime& currentTime) {
  if (currentTime.day() != lastRecordedDay) {
    lastRecordedDay = currentTime.day();
    totalPulsesToday = 0;
  }
}

float calculateScheduledAngle(const DateTime& currentTime) {
  const int currentMinuteOfDay = currentTime.hour() * 60 + currentTime.minute();

  if (currentMinuteOfDay <= START_MINUTE_OF_DAY) {
    return PANEL_MIN_ANGLE;
  }
  // Pasadas las 6 PM (18:00), el panel se regresa a -30°
  if (currentMinuteOfDay >= END_MINUTE_OF_DAY) {
    return PANEL_MIN_ANGLE;
  }

  const int elapsedMinutes = currentMinuteOfDay - START_MINUTE_OF_DAY;
  const int completedDiscreteMinutes = (elapsedMinutes / discretizationMinutes) * discretizationMinutes;

  const float angle = PANEL_MIN_ANGLE + PANEL_TOTAL_RANGE *
      (static_cast<float>(completedDiscreteMinutes) / TRACKING_DURATION_MINUTES);

  return clampPanelAngle(angle);
}

void checkPost6pmTest() {
  if (!isPost6pmTestActive) return;
  
  if (millis() - post6pmTestStartMillis < 60000UL) {
    targetPanelAngle = PANEL_MAX_ANGLE; // +30° durante el primer minuto
  } else {
    targetPanelAngle = PANEL_MIN_ANGLE; // Retorna a -30°
    if (abs(currentPanelAngle - targetPanelAngle) <= ANGLE_TOLERANCE_STOP) {
      isPost6pmTestActive = false;
      Serial.println("Prueba Post-6PM finalizada. Sistema posicionado en -30°.");
    }
  }
}

void updateTargetFromRtc() {
  DateTime currentTime;
  rtcTimeIsValid = readRtcClock(currentTime);

  if (!mpuDetected || !rtcDetected || !rtcTimeIsValid) {
    // Cualquier pérdida de referencia angular o temporal inmoviliza el sistema.
    systemState = SystemState::SAFETY_LOCK;
    isTargetReached = true;
    return;
  }

  checkAndResetDailyPulses(currentTime);

  // Candado fuerte para pausa
  if (!movementPaused) {
    if (currentTime.hour() * 60 + currentTime.minute() >= END_MINUTE_OF_DAY && systemState == SystemState::WAITING_FOR_MPU) {
      // Activar prueba 6pm si arranca por primera vez en la noche
      isPost6pmTestActive = true;
      post6pmTestStartMillis = millis();
    }

    if (isPost6pmTestActive) {
      checkPost6pmTest();
    } else {
      scheduledTheoreticalAngle = calculateScheduledAngle(currentTime);
      targetPanelAngle = scheduledTheoreticalAngle;
    }
  }

  float error = abs(targetPanelAngle - currentPanelAngle);

  // Lógica de Histéresis: 
  // Arranca solo si supera el umbral alto, se detiene al cruzar el umbral bajo.
  if (isTargetReached && error > ANGLE_TOLERANCE_START) {
    isTargetReached = false;
  }
  
  if (!isTargetReached && error <= ANGLE_TOLERANCE_STOP) {
    isTargetReached = true;
  }

  systemState = isTargetReached ? SystemState::RESTING : SystemState::MOVING;
}

String formattedRtcTime() {
  DateTime currentTime;
  if (!readRtcClock(currentTime)) {
    return "--";
  }
  char buffer[30];
  snprintf(buffer, sizeof(buffer), "%02u/%02u/%04u %02u:%02u:%02u",
      currentTime.day(), currentTime.month(), currentTime.year(),
      currentTime.hour(), currentTime.minute(), currentTime.second());
  return String(buffer);
}

// ============================================================
// 8. CONTROL DEL MOTOR, TORQUE Y LAZO CERRADO IMU
// ============================================================

bool isMotor1Enabled() {
  return digitalRead(ENA_PIN_1) == MOTOR_ENABLE_LEVEL;
}

void enableMotor1() {
  digitalWrite(ENA_PIN_1, MOTOR_ENABLE_LEVEL);
}

void disableMotor1() {
  digitalWrite(ENA_PIN_1, MOTOR_DISABLE_LEVEL);
}

void setMotorDirection(int8_t direction) {
  uint8_t level = (direction > 0) ? DIR_LEVEL_TO_POSITIVE : (DIR_LEVEL_TO_POSITIVE == HIGH ? LOW : HIGH);
  digitalWrite(DIR_PIN_1, level);
}

void generateOnePulse() {
  digitalWrite(STEP_PIN_1, STEP_ACTIVE_LEVEL);
  delayMicroseconds(STEP_PULSE_WIDTH_US);
  digitalWrite(STEP_PIN_1, STEP_IDLE_LEVEL);
}

uint32_t stepIntervalUsForRate(float ratePps) {
  if (ratePps < 1.0f) ratePps = 1.0f;
  return static_cast<uint32_t>(1000000.0f / ratePps);
}

uint32_t currentStepIntervalUs() {
  const float safeRate = (instantaneousCommandRatePps > 0.0f)
          ? instantaneousCommandRatePps
          : START_STEP_RATE_PPS;
  return stepIntervalUsForRate(safeRate);
}

void registerGeneratedPulse() {
  pulseCounterWindow++;
  totalGeneratedPulses++;
  totalPulsesToday++;
}

void updateMeasuredPulseSpeed() {
  const uint32_t nowMicros = micros();
  const uint32_t elapsedMicros = nowMicros - speedWindowStartMicros;

  if (elapsedMicros < 500000UL) return;

  measuredStepRatePps = pulseCounterWindow * (1000000.0f / static_cast<float>(elapsedMicros));
  pulseCounterWindow = 0;
  speedWindowStartMicros = nowMicros;
}

void resetMotionRamp() {
  instantaneousCommandRatePps = 0.0f;
  activeMotorDirection = 0;
  lastRampUpdateMicros = micros();
  nextPulseMicros = micros();
}

void updateMotionRamp() {
  const uint32_t nowMicros = micros();
  const uint32_t elapsedMicros = nowMicros - lastRampUpdateMicros;

  if (elapsedMicros < 1000UL) return;
  lastRampUpdateMicros = nowMicros;

  if (!mpuDetected || !rtcTimeIsValid || isTargetReached) {
    instantaneousCommandRatePps = 0.0f;
    return;
  }

  // Traducción matemática del error angular a un "equivalente en pulsos" 
  // para seguir aprovechando la rampa de aceleración previa
  const float degreeError = abs(targetPanelAngle - currentPanelAngle);
  const int32_t remainingVirtualPulses = static_cast<int32_t>(degreeError / PANEL_DEGREES_PER_PULSE);

  const float brakingLimitedRate = sqrtf(2.0f * ACCELERATION_PPS2 * remainingVirtualPulses);

  float desiredRate = min(static_cast<float>(FIXED_STEP_RATE_PPS), brakingLimitedRate);
  const float minimumMovingRate = min(static_cast<float>(FIXED_STEP_RATE_PPS), START_STEP_RATE_PPS);

  if (desiredRate < minimumMovingRate) {
    desiredRate = minimumMovingRate;
  }

  if (instantaneousCommandRatePps <= 0.0f) {
    instantaneousCommandRatePps = minimumMovingRate;
    return;
  }

  const float maximumRateChange = ACCELERATION_PPS2 * (static_cast<float>(elapsedMicros) / 1000000.0f);

  if (instantaneousCommandRatePps < desiredRate) {
    instantaneousCommandRatePps = min(desiredRate, instantaneousCommandRatePps + maximumRateChange);
  } else if (instantaneousCommandRatePps > desiredRate) {
    instantaneousCommandRatePps = max(desiredRate, instantaneousCommandRatePps - maximumRateChange);
  }
}

bool hasSafetyFault() {
  return !mpuDetected || !rtcDetected || !rtcTimeIsValid;
}

void engageMotorSafetyLock() {
  // IMPORTANTE: en un TB6600 habilitado y sin pulsos STEP, el NEMA 23
  // conserva torque de retención. Esto evita que el panel quede libre.
  instantaneousCommandRatePps = 0.0f;
  activeMotorDirection = 0;
  isTargetReached = true;
  systemState = SystemState::SAFETY_LOCK;
  digitalWrite(STEP_PIN_1, STEP_IDLE_LEVEL);
  enableMotor1();
}

void serviceMotor() {
  if (hasSafetyFault()) {
    engageMotorSafetyLock();
    return;
  }

  if (isTargetReached) {
    systemState = SystemState::RESTING;
    resetMotionRamp();
    // Motor activado con torque para resistir fuerza del viento al estar en descanso
    enableMotor1();
    return;
  }

  updateMotionRamp();

  // Determinar dirección en lazo cerrado respecto al sensor IMU real
  const int8_t direction = (targetPanelAngle > currentPanelAngle) ? 1 : -1;
  uint32_t nowMicros = micros();

  enableMotor1();

  if (direction != activeMotorDirection) {
    setMotorDirection(direction);
    activeMotorDirection = direction;
    instantaneousCommandRatePps = min(static_cast<float>(FIXED_STEP_RATE_PPS), START_STEP_RATE_PPS);
    nextPulseMicros = nowMicros + DIR_SETUP_TIME_US + currentStepIntervalUs();
    return;
  }

  if (static_cast<int32_t>(nowMicros - nextPulseMicros) < 0) return;

  generateOnePulse();
  registerGeneratedPulse();
  systemState = SystemState::MOVING;

  const uint32_t intervalUs = currentStepIntervalUs();
  nextPulseMicros += intervalUs;

  nowMicros = micros();
  if (static_cast<int32_t>(nowMicros - nextPulseMicros) > static_cast<int32_t>(intervalUs * 2UL)) {
    nextPulseMicros = nowMicros + intervalUs;
  }
}

// ============================================================
// 9. WIFI, NTP Y AP LOCAL
// ============================================================

void disableStationAndKeepAccessPoint() {
  if (!stationInterfaceEnabled) return;

  WiFi.setAutoReconnect(false);
  WiFi.disconnect(false, false);
  delay(20);

  WiFi.mode(WIFI_AP);
  stationInterfaceEnabled = false;
  startupInternetFinished = true;
}

void startWiFi() {
  WiFi.persistent(false);
  WiFi.mode(WIFI_AP_STA);
  WiFi.setAutoReconnect(false);

  WiFi.softAP(AP_SSID, AP_PASSWORD);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  wifiStartupMillis = millis();
  lastWifiRetryMillis = millis();
}

void synchronizeRtcFromNtp(const struct tm& timeInfo) {
  const DateTime networkTime(
      timeInfo.tm_year + 1900, timeInfo.tm_mon + 1, timeInfo.tm_mday,
      timeInfo.tm_hour, timeInfo.tm_min, timeInfo.tm_sec);

  rtc.adjust(networkTime);
  rtcTimeIsValid = true;
  rtcWasSynchronizedByNtp = true;
}

void maintainStartupInternetAndRtc() {
  if (startupInternetFinished) return;

  if (!rtcDetected) {
    // No abandonamos inmediatamente el intento de Internet: el RTC puede
    // reconectarse durante los primeros segundos de arranque.
    if (millis() - wifiStartupMillis >= INTERNET_STARTUP_TIMEOUT_MS) {
      disableStationAndKeepAccessPoint();
    }
    return;
  }

  if (WiFi.status() == WL_CONNECTED) {
    if (!ntpWasStarted) {
      configTime(GMT_OFFSET_SECONDS, DAYLIGHT_OFFSET_SECONDS, NTP_SERVER_1, NTP_SERVER_2);
      ntpWasStarted = true;
    }

    struct tm timeInfo;
    if (getLocalTime(&timeInfo, 10)) {
      synchronizeRtcFromNtp(timeInfo);
      disableStationAndKeepAccessPoint();
      updateTargetFromRtc();
      return;
    }
  } else if (millis() - lastWifiRetryMillis >= WIFI_RETRY_INTERVAL_MS) {
    lastWifiRetryMillis = millis();
    WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  }

  if (millis() - wifiStartupMillis >= INTERNET_STARTUP_TIMEOUT_MS) {
    DateTime currentTime;
    rtcTimeIsValid = readRtcClock(currentTime);
    disableStationAndKeepAccessPoint();
    updateTargetFromRtc();
  }
}

