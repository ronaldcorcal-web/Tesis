void handleRoot() {
  server.send_P(200, "text/html; charset=utf-8", INDEX_HTML);
}

void handleStatus() {
  const float anglePerInterval = PANEL_TOTAL_RANGE *
      (static_cast<float>(discretizationMinutes) / TRACKING_DURATION_MINUTES);

  String json;
  json.reserve(1024);

  json += "{";
  json += "\"stateCode\":\""; json += stateCode(); json += "\",";
  json += "\"stateText\":\""; json += stateText(); json += "\",";
  json += "\"mpuDetected\":"; json += mpuDetected ? "true" : "false"; json += ",";
  json += "\"rtcDetected\":"; json += rtcDetected ? "true" : "false"; json += ",";
  json += "\"timeValid\":"; json += rtcTimeIsValid ? "true" : "false"; json += ",";
  json += "\"time\":\""; json += formattedRtcTime(); json += "\",";
  json += "\"movementPaused\":"; json += movementPaused ? "true" : "false"; json += ",";
  json += "\"safetyLock\":"; json += hasSafetyFault() ? "true" : "false"; json += ",";
  
  json += "\"motor1Active\":"; json += isMotor1Enabled() ? "true" : "false"; json += ",";
  json += "\"motorDirection\":"; json += String(activeMotorDirection); json += ",";
  json += "\"motorSpeedPPS\":"; json += String(measuredStepRatePps, 4); json += ",";
  
  // Vueltas acumuladas totales realizadas por este motor en todo su trabajo hoy
  json += "\"motor1Turns\":"; json += String(static_cast<float>(totalGeneratedPulses) / DRIVER_PULSES_PER_MOTOR_REVOLUTION, 2); json += ",";
  
  json += "\"motorSpeedDeg\":"; json += String(measuredStepRatePps * MOTOR_DEGREES_PER_PULSE, 2); json += ",";

  json += "\"isPost6pmTest\":"; json += isPost6pmTestActive ? "true" : "false"; json += ",";
  json += "\"testMessage\":\"Prueba Post-6PM Activa: Moviéndose hacia +30° y luego retornará a -30° para comprobar funcionamiento\",";

  json += "\"currentAngle\":"; json += String(currentPanelAngle, 4); json += ",";
  json += "\"targetAngle\":"; json += String(targetPanelAngle, 4); json += ",";

  const float measuredPanelDegreesPerSecond = measuredStepRatePps * PANEL_DEGREES_PER_PULSE;
  json += "\"measuredPanelDegreesPerSecond\":"; json += String(measuredPanelDegreesPerSecond, 4); json += ",";
  json += "\"intervalMinutes\":"; json += String(discretizationMinutes); json += ",";
  json += "\"anglePerInterval\":"; json += String(anglePerInterval, 4); json += ",";
  json += "\"apIP\":\""; json += WiFi.softAPIP().toString(); json += "\"";
  json += "}";

  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "application/json; charset=utf-8", json);
}

void handleStopMovement() {
  movementPaused = true;
  if (mpuDetected) {
    targetPanelAngle = currentPanelAngle;
  }
  isTargetReached = true;
  systemState = SystemState::RESTING;
  resetMotionRamp();

  if (hasSafetyFault()) {
    engageMotorSafetyLock();
    server.send(200, "application/json", "{\"ok\":true,\"message\":\"Movimiento detenido. Bloqueo de seguridad con torque activo.\"}");
  } else {
    server.send(200, "application/json", "{\"ok\":true,\"message\":\"Movimiento detenido exitosamente.\"}");
  }
}

void handleContinueMovement() {
  if (!mpuDetected || !rtcDetected || !rtcTimeIsValid) {
    server.send(400, "application/json", "{\"ok\":false,\"message\":\"No se puede reanudar: bloqueo de seguridad activo por MPU/RTC.\"}");
    return;
  }

  movementPaused = false;
  updateTargetFromRtc();

  server.send(200, "application/json", "{\"ok\":true,\"message\":\"Movimiento reanudado correctamente.\"}");
}

void handleSetInterval() {
  if (!server.hasArg("minutes")) {
    server.send(400, "application/json", "{\"ok\":false,\"message\":\"Falta el valor en minutos.\"}");
    return;
  }

  const long newValue = server.arg("minutes").toInt();
  if (newValue < 1 || newValue > TRACKING_DURATION_MINUTES) {
    server.send(400, "application/json", "{\"ok\":false,\"message\":\"Ingrese un entero entre 1 y 720 minutos.\"}");
    return;
  }

  discretizationMinutes = static_cast<uint16_t>(newValue);
  preferences.putUShort("interval", discretizationMinutes);
  
  updateTargetFromRtc();

  server.send(200, "application/json", "{\"ok\":true,\"minutes\":" + String(discretizationMinutes) + "}");
}

void handleNotFound() {
  server.send(404, "application/json", "{\"ok\":false,\"message\":\"Ruta no encontrada.\"}");
}

void startWebServer() {
  server.on("/", HTTP_GET, handleRoot);
  server.on("/status", HTTP_GET, handleStatus);
  server.on("/stopMovement", HTTP_POST, handleStopMovement);
  server.on("/continueMovement", HTTP_POST, handleContinueMovement);
  server.on("/setInterval", HTTP_POST, handleSetInterval);
  server.onNotFound(handleNotFound);
  server.begin();
}

// ============================================================
// 11. INICIALIZACION I2C (RTC Y MPU)
// ============================================================

void detectRtc() {
  const bool addressPresent = i2cAddressResponds(Wire, DS3231_ADDR);

  if (!addressPresent) {
    if (rtcDetected) {
      Serial.println("RTC DS3231 perdido: 0x68 dejo de responder.");
    }
    rtcDetected = false;
    rtcTimeIsValid = false;
    return;
  }

  if (!rtcDetected) {
    rtcDetected = rtc.begin(&Wire);
    if (rtcDetected) {
      Serial.println("RTC DS3231 detectado correctamente en 0x68.");
    } else {
      Serial.println("Hay respuesta en 0x68, pero RTClib no pudo iniciar el DS3231.");
      rtcTimeIsValid = false;
      return;
    }
  }

  DateTime currentTime;
  rtcTimeIsValid = readRtcClock(currentTime);
  if (rtcTimeIsValid) {
    checkAndResetDailyPulses(currentTime);
  }
}

void serviceI2CDevices() {
  if (millis() - lastI2CRetryMillis < I2C_RETRY_INTERVAL_MS) return;
  lastI2CRetryMillis = millis();

  // Verificar RTC aun cuando antes estuviera conectado, para detectar desconexiones.
  if (!i2cAddressResponds(Wire, DS3231_ADDR)) {
    if (rtcDetected) Serial.println("RTC DS3231 desconectado. BLOQUEO DE SEGURIDAD.");
    rtcDetected = false;
    rtcTimeIsValid = false;
  } else if (!rtcDetected) {
    detectRtc();
  }

  // Si el MPU se perdió, intentar recuperarlo automáticamente.
  if (!mpuDetected) {
    initializeMPU();
    if (mpuDetected) {
      // Unas lecturas iniciales para estabilizar el filtro.
      for (int i = 0; i < 10; ++i) {
        readMPUAngle();
        delay(5);
      }
    }
  }
}

void initializeI2CDevices() {
  // RTC DS3231 en el controlador I2C 0
  Wire.begin(RTC_SDA_PIN, RTC_SCL_PIN);
  Wire.setClock(100000); // 100 kHz: más tolerante para cableado de prototipo

  // MPU6050 en el controlador I2C 1, completamente separado del RTC
  mpuWire.begin(MPU_SDA_PIN, MPU_SCL_PIN, 100000);

  delay(100);

  scanI2CBus(Wire, "I2C RTC (SDA 21 / SCL 22)");
  scanI2CBus(mpuWire, "I2C MPU6050 (SDA 32 / SCL 33)");

  // RTC DS3231 en 0x68, bus Wire
  detectRtc();

  // MPU6050 en 0x68, bus mpuWire
  initializeMPU();

  if (mpuDetected) {
    for (int i = 0; i < 20; ++i) {
      readMPUAngle();
      delay(10);
    }
  }
}

// ============================================================
// 12. SETUP Y LOOP
// ============================================================

void setup() {
  Serial.begin(115200);
  delay(300);

  // Pines Motor 1
  pinMode(STEP_PIN_1, OUTPUT);
  pinMode(DIR_PIN_1, OUTPUT);
  pinMode(ENA_PIN_1, OUTPUT);
  digitalWrite(STEP_PIN_1, STEP_IDLE_LEVEL);
  disableMotor1();
  
  preferences.begin("tracker", false);
  discretizationMinutes = preferences.getUShort("interval", 60);
  if (discretizationMinutes < 1 || discretizationMinutes > TRACKING_DURATION_MINUTES) {
    discretizationMinutes = 60;
  }

  initializeI2CDevices();
  startWiFi();
  startWebServer();

  lastScheduleUpdateMillis = millis();
  lastMpuReadMillis = millis();
  lastI2CRetryMillis = millis();
  nextPulseMicros = micros();
  speedWindowStartMicros = micros();
}

void loop() {
  server.handleClient();
  serviceI2CDevices();
  maintainStartupInternetAndRtc();

  // Lectura continua del MPU (cada 20ms aprox)
  if (millis() - lastMpuReadMillis >= 20UL) {
    lastMpuReadMillis = millis();
    readMPUAngle();
  }

  // Refrescar cronograma objetivo 1 vez por segundo
  if (millis() - lastScheduleUpdateMillis >= 1000UL) {
    lastScheduleUpdateMillis = millis();
    updateTargetFromRtc();
  }

  serviceMotor();
  updateMeasuredPulseSpeed();
  delay(0);
}
