    case SystemState::WAITING_FOR_MPU: return "WAITING_FOR_MPU";
    case SystemState::WAITING_FOR_RTC: return "WAITING_FOR_RTC";
    case SystemState::SAFETY_LOCK: return "SAFETY_LOCK";
    case SystemState::MOVING: return "MOVING";
    case SystemState::RESTING: return "RESTING";
  }
  return "UNKNOWN";
}

const char* stateText() {
  switch (systemState) {
    case SystemState::WAITING_FOR_MPU: return "Esperando Giroscopio MPU6050";
    case SystemState::WAITING_FOR_RTC: return "Esperando hora válida del RTC";
    case SystemState::SAFETY_LOCK: return "BLOQUEO DE SEGURIDAD - Sensor/RTC no disponible";
    case SystemState::MOVING: return "Movimiento";
    case SystemState::RESTING: return "Descanso";
  }
